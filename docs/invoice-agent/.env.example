ANTHROPIC_API_KEY=sk-ant-...
# Port 5433, not 5432: avoids clashing with a locally-installed Postgres (see docker-compose.yml)
# 127.0.0.1, not "localhost": on Windows, "localhost" resolves to ::1 first, and
# nothing listens there for Docker Desktop's port mapping -- psycopg then waits out a
# long OS-level IPv6 connect timeout before falling back to IPv4. Measured live: ~130s
# per connection with "localhost", ~0.06s with "127.0.0.1". See decisions_log.md section 5.
DATABASE_URL=postgresql://ap:ap@127.0.0.1:5433/invoice_agent
# Production (Streamlit Cloud) points this at a Databricks Lakebase instance
# instead -- same schema.sql, same psycopg3 code, just a different host.
# See decisions_log.md section 8 for why Lakebase over Neon/SQLite, and for
# the one real gotcha: a freshly-created password role has CREATEDB but no
# CREATE privilege on Lakebase's shared default "databricks_postgres" database,
# so it needs its own database (CREATE DATABASE as that role) rather than
# creating schemas inside the shared default one.

# Streamlit app (section 7). APP_PASSWORD gates the whole app behind a
# single shared password (no per-user accounts -- this is a portfolio demo,
# not a multi-tenant product). DAILY_API_LIMIT caps how many real extraction
# calls the "upload your own invoice" page can trigger across *all*
# visitors combined per calendar day (see invoice_agent.db.try_consume_daily_quota) --
# the actual spend guard for a public deployment.
APP_PASSWORD=change-me
DAILY_API_LIMIT=20
