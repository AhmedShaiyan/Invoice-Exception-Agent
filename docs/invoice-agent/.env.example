ANTHROPIC_API_KEY=sk-ant-...
# Port 5433, not 5432: avoids clashing with a locally-installed Postgres (see docker-compose.yml)
# 127.0.0.1, not "localhost": on Windows, "localhost" resolves to ::1 first, and
# nothing listens there for Docker Desktop's port mapping -- psycopg then waits out a
# long OS-level IPv6 connect timeout before falling back to IPv4. Measured live: ~130s
# per connection with "localhost", ~0.06s with "127.0.0.1". See decisions_log.md section 5.
DATABASE_URL=postgresql://ap:ap@127.0.0.1:5433/invoice_agent
